{
  "name": "spotter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["app", "packages/evals"],
  "scripts": {
    "dev": "bun --watch app/src/server.ts",
    "start": "bun app/src/server.ts",
    "test": "bun test",
    "check": "bunx tsc --noEmit -p app && bunx tsc --noEmit -p packages/evals",
    "build:css": "cp design-system/dist/spotter.css app/public/spotter.css",
    "spotter": "bun packages/evals/src/cli.ts"
  },
  "engines": {
    "bun": "1.3.9"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "bin": {
    "spotter": "packages/evals/src/cli.ts"
  }
}
