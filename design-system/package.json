{
  "name": "@copper/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tokens, component contracts, and generated CSS for Copper Evaluations.",
  "scripts": {
    "build": "node --experimental-strip-types src/build.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "build:docs": "node --experimental-strip-types src/build-docs.ts",
    "check:deps": "node scripts/check-release-age.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./icons": "./src/icons.ts",
    "./css": "./src/css.ts",
    "./components": "./src/components.ts"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "marked": "18.0.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=25",
    "bun": "1.3.9"
  }
}
